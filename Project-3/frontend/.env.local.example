# The Vite proxy forwards all /api/* requests to your backend — no CORS issues.
# Only set VITE_BACKEND_URL if your backend runs somewhere other than https://localhost:7001
# VITE_BACKEND_URL=https://localhost:7001

# Leave VITE_API_BASE_URL empty when using the Vite proxy (default for local dev).
# Set it to the full backend URL only if you are NOT using vite.config.local.ts.
# VITE_API_BASE_URL=https://localhost:7001
